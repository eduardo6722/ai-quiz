{
  "name": "ai-quiz",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @ai-quiz/api db:generate",
    "db:migrate": "pnpm --filter @ai-quiz/api db:migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
