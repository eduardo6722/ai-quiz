# Local development only — copy to .env. Never commit real secrets.

# Required for the API (PostgreSQL). Must not be logged.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_quiz?schema=public

# Integration/API tests use a separate database on the same instance (not required to start the apps):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_quiz_test?schema=public

# Optional Prisma direct URL. Local default may equal DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_quiz?schema=public

# API listen port (integer, default 3001)
PORT=3001

# Required for the web shell (absolute API origin)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional CORS allowlist for the web origin (browser → API). Default matches local Next.js.
WEB_ORIGIN=http://localhost:3000

# Optional
NODE_ENV=development

# OpenAI is optional at API boot. Product create-quiz and live README evidence need both.
# Default suites (pnpm test / test:e2e with port overrides) do not require a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional Langfuse tracing. Empty keys mean create-quiz still works (no-op telemetry).
# Incomplete public-without-secret is treated as unconfigured. Do not commit real secrets.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Optional label attached to traces (not a secret).
PROMPT_VERSION=

# Optional judge model for `pnpm eval:golden`. Empty means use OPENAI_MODEL.
# `pnpm eval:golden` is not part of `pnpm test`. Use --mocked without paid keys.
EVAL_JUDGE_MODEL=

# Operational bounds (enforced in code; comments only here):
# - Markdown fetch timeout: 10 seconds
# - Snapshot max: 512 KiB
# - Generation retries: 3
# - Create-quiz rate: 5 attempted creates per 60 seconds (per client IP)
# - Create-quiz concurrency: 2 in-flight generations per process
#
# Production / CI notes (no extra keys required here):
# - Development Compose: compose.yml + Dockerfile.dev (watch mode). Volume ai_quiz_pgdata.
# - Production-shaped Compose: compose.prod.yml. Volume ai_quiz_prod_pgdata (separate from dev).
# - CI integration/E2E database: ai_quiz_test on the same Postgres instance.
# - CI and production schema apply: pnpm db:migrate:deploy (prisma migrate deploy), never migrate dev.
# - Container registry, DEPLOY_TARGET, and production NEXT_PUBLIC_API_URL live in GitHub Environments, not this file.
